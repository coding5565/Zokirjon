# Токен бота, полученный у @BotFather в Telegram
BOT_TOKEN=

# Ключ OpenAI API, полученный на https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Модель OpenAI для текстового/визуального фидбека (Writing) и разбора
# транскрипта (Speaking). Дешёвая и достаточно качественная модель по умолчанию.
OPENAI_MODEL=gpt-4o-mini

# Модель распознавания речи (транскрибация голосовых/видео для Speaking)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Telegram ID учителей через запятую (узнать свой ID можно у @userinfobot)
# Только эти пользователи получают доступ к учительскому функционалу бота.
TEACHER_IDS=123456789

# Путь к файлу базы данных SQLite (необязательно, по умолчанию bot.db рядом с проектом)
DATABASE_PATH=bot.db

# Максимальный размер аудио/видео файла для Speaking, в мегабайтах
MAX_MEDIA_SIZE_MB=20
